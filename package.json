{
  "name": "tr-coaching-control-plane",
  "version": "0.1.0",
  "private": true,
  "description": "TR Training business control plane: lifecycle orchestration with dry-run connectors. Not a social-content tool.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.web.json",
    "test": "node --import tsx --test test/*.test.ts",
    "validate": "tsx src/cli.ts validate",
    "benchmark:social": "tsx src/cli.ts benchmark-social",
    "qa:social": "tsx src/cli.ts qa-social",
    "console:dev": "tsc -p tsconfig.web.json && tsx src/console/http.ts",
    "console:start": "node dist/console/http.js",
    "console:build": "tsc -p tsconfig.json && tsc -p tsconfig.web.json",
    "console:check": "tsc -p tsconfig.web.json && tsx src/console/check.ts",
    "console:hash-password": "tsx src/console/hash-password.ts"
  },
  "bin": {
    "tr-control": "./dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "sharp": "^0.35.4"
  }
}
