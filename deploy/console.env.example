# Copy to a private env file. Never commit real values.
NODE_ENV=production
FOUNDER_CONSOLE_HOST=127.0.0.1
FOUNDER_CONSOLE_PORT=8787
FOUNDER_CONSOLE_ALLOW_REMOTE=0
FOUNDER_CONSOLE_SECURE_COOKIES=1
FOUNDER_CONSOLE_DATA_DIR=/var/lib/tr-console
FOUNDER_SESSION_SECRET=
FOUNDER_AUTH_USER=founder
FOUNDER_AUTH_PASSWORD_HASH=
# Dev-only (localhost). Do not set in production.
FOUNDER_CONSOLE_DEV_AUTH=0
FOUNDER_DEV_PASSWORD=
FOUNDER_CONSOLE_DEMO_FIXTURES=0
# Optional least-privilege read tokens. Leave empty = NOT_CONNECTED.
TR_DRIVE_READONLY_TOKEN=
TR_CRM_READONLY_TOKEN=
TR_CRM_READONLY_URL=
TR_METRICOOL_READONLY_TOKEN=
TR_METRICOOL_READONLY_URL=
TR_STRIPE_READONLY_TOKEN=
TR_SUPERSET_READONLY_TOKEN=
TR_SUPERSET_READONLY_URL=
GITHUB_READONLY_TOKEN=
# Slack dispatch (allowlisted #ai-ops only)
SLACK_DISPATCH_ENABLED=0
SLACK_BOT_TOKEN=
SLACK_AI_OPS_CHANNEL=#ai-ops
# Cursor Cloud Agents API v1 (public beta). Server-only key. Exact repo allowlist.
CURSOR_CLOUD_AGENT_TOKEN=
CURSOR_ALLOW_REPO=TRCoach/TRCoaching
CURSOR_STARTING_REF=main
CURSOR_MODEL=
# ChatGPT/OpenAI Responses. Spend stays disabled unless all three are set after data-control review.
FOUNDER_CHATGPT_DISPATCH=0
OPENAI_API_KEY=
OPENAI_MODEL=
