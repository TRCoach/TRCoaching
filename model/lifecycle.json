  "owners": ["Taylor", "Sam", "Jordan", "Alex", "ChatGPT", "Cursor", "Grok", "Founder"],
  "states": [
    "uninitialized",
    "marketing_active",
    "social_enquiry_received",
    "enquiry_classified",
    "nurture",
    "qualification",
    "offer_presented",
    "payment_pending",
    "payment_verified",
    "closed_won",
    "onboarding_started",
    "privacy_notice_issued",
    "health_consent_recorded",
    "screening",
    "ready",
    "programme_draft",
    "founder_golive_approved",
    "assigned_welcomed",
    "active_coaching",
    "weekly_checkin_open",
    "adherence_escalation",
    "retention_review",
    "renewal_offered",
    "cancellation_requested",
    "refund_credit_hold",
    "offboarding",
    "closed_lost",
    "blocked",
    "social_asset_drafted",
    "social_qa_recorded",
    "publish_eligible"
