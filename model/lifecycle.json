      "to": "qualification",
      "event": "qualify_lead",
      "owner": "Sam",
      "requiredEvidence": ["non_pii_enquiry_ref", "qualification_outcome"],
      "systemOfRecord": "CRM",
      "automatedAction": "dry_run.update_commercial_stage",
      "guard": "allow",
      "stopCondition": "missing_qualification_outcome",
      "retryPolicy": { "maxAttempts": 2, "backoffSeconds": 60, "escalateTo": "Alex", "onExhausted": "fail_closed" },
      "nextTrigger": "present_offer",
      "founderGate": false,
      "idempotencyKey": "qualify_lead:{non_pii_enquiry_ref}"
    },
    {
      "id": "t_closed_lost_from_qualification",
