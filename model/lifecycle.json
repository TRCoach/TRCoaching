      "nextTrigger": "social_enquiry_or_asset_draft",
      "founderGate": false,
      "idempotencyKey": "start_marketing:{campaign_ref}"
    },
    {
      "id": "t_social_enquiry",
      "from": "marketing_active",
      "to": "social_enquiry_received",
      "event": "social_enquiry",
      "owner": "Taylor",
      "requiredEvidence": ["enquiry_channel", "enquiry_received_at", "non_pii_enquiry_ref"],
