      "systemOfRecord": "CRM",
      "automatedAction": "dry_run.queue_nurture",
      "guard": "allow",
      "stopCondition": "publication_or_paid_spend_requested",
      "retryPolicy": { "maxAttempts": 3, "backoffSeconds": 120, "escalateTo": "Alex", "onExhausted": "fail_closed" },
